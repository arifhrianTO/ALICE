# Normalisasi LF untuk file teks di semua sistem operasi
* text=auto eol=lf

# File Flutter & Kode Sumber
*.dart text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.c text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cc text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.swift text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.go text eol=lf

# Script khusus Windows
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# File biner (jangan ubah line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.dll binary
*.so binary
