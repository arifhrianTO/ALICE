# Contoh isi file .env
#
# Cara pakai:
#   cp .env.example .env
# lalu isi nilainya.
#
# File .env ASLI tidak boleh di-commit ke Git karena berisi password.
# File contoh ini yang di-commit, sebagai template untuk tim.

# --- Aplikasi ---
APP_ENV=development
APP_PORT=8080

# --- Database PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=app_user
# JANGAN diisi di file ini! Nilai asli hanya boleh ada di .env (yang tidak
# di-commit). File contoh ini ikut ter-commit, jadi apa pun yang kamu tulis
# di sini akan terbaca semua orang.
DB_PASSWORD=
DB_NAME=db_alice
DB_SSLMODE=disable

# --- Autentikasi ---
SESSION_TTL_HOURS=24
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Enkripsi data sensitif ---
# Kunci AES-256 untuk mengenkripsi nomor telepon & alamat pendamping.
# Format: base64 dari 32 byte acak. Buat dengan:
#   openssl rand -base64 32
#
# JANGAN isi nilai asli di file contoh ini (file ini ikut ter-commit).
# Simpan nilai asli hanya di .env / secret manager. Kalau kunci hilang,
# data yang sudah terenkripsi TIDAK bisa dipulihkan.
PROFILE_ENCRYPTION_KEY=